rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the requester is the user themselves or one of their managers.
    // managers[] is a CF-maintained array of User doc IDs up the chain.
    function canAccessUser(userId) {
      let user = get(/databases/$(database)/documents/Users/$(userId));
      return isSignedIn() && (
        request.auth.token.userId == userId ||
        request.auth.token.userId in user.data.get('managers', [])
      );
    }

    // Whether this user's app is new enough to start a session. A missing
    // Config/app, or no minBuild for the user's platform, means no enforcement.
    function appIsCurrent(userId) {
      let user = get(/databases/$(database)/documents/Users/$(userId)).data;
      let cfg = get(/databases/$(database)/documents/Config/app).data;
      return !exists(/databases/$(database)/documents/Config/app) ||
        user.get('appBuild', 0) >=
          cfg.get(user.get('platform', 'android'), {}).get('minBuild', 0);
    }

    // Whether the caller is the owner of this org code (Codes/{code}.userId).
    function isCodeOwner(code) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/Codes/$(code)).data.get('userId', '')
          == request.auth.token.userId;
    }

    // Whether the caller belongs to this org code.
    function isOrgMember(code) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/Users/$(request.auth.token.userId))
          .data.get('code', '') == code;
    }

    function validShift(d) {
      return d.keys().hasOnly(['name', 'startMinute', 'endMinute', 'endNextDay',
                               'inLocation', 'outLocation', 'radiusM', 'userIds',
                               'updatedAt']) &&
        d.get('name', '') is string && d.get('name', '').size() <= 60 &&
        d.get('userIds', []) is list && d.get('userIds', []).size() <= 500 &&
        d.get('startMinute', 0) is int &&
        d.get('startMinute', 0) >= 0 && d.get('startMinute', 0) < 1440 &&
        d.get('endMinute', 0) is int &&
        d.get('endMinute', 0) >= 0 && d.get('endMinute', 0) < 1440 &&
        d.get('radiusM', 100) is int &&
        d.get('radiusM', 100) >= 20 && d.get('radiusM', 100) <= 5000;
    }

    // Today's date in India (yyyy-MM-dd), the day key of the assistant's usage doc.
    function istDate() {
      let t = request.time + duration.value(330, 'm');
      return string(t.year()) + '-' + (t.month() < 10 ? '0' : '') + string(t.month())
        + '-' + (t.day() < 10 ? '0' : '') + string(t.day());
    }

    // The daily AI credit limit, editable in Config/assistant without a deploy.
    function assistantLimit() {
      return get(/databases/$(database)/documents/Config/assistant).data.get('dailyCredits', 100);
    }

    // ─── Codes — public read; the doc itself is written via CF only ──────────
    match /Codes/{code} {
      allow read: if true;

      // Shifts: members read them (to find their own shift and its location),
      // only the code's owner writes. Reminders are sent by a server function.
      match /Shifts/{shiftId} {
        allow read: if isCodeOwner(code) || isOrgMember(code);
        allow create, update: if isCodeOwner(code) && validShift(request.resource.data);
        allow delete: if isCodeOwner(code);
      }
    }

    // ─── Config/assistant — the AI assistant's settings: read-only for the app ─
    match /Config/assistant {
      allow read: if isSignedIn();
    }

    // ─── AI assistant usage: one doc per user per day ────────────────────────
    // credits = model calls used today; entries = declined / failed requests.
    // The count can only go up by one at a time and never past the limit; the
    // list can only grow. The day key must be today's date in India.
    match /AssistantLog/{userId}/Dates/{date} {
      allow read: if isSignedIn() && request.auth.token.userId == userId;
      allow create: if isSignedIn() && request.auth.token.userId == userId &&
        date == istDate() &&
        request.resource.data.keys().hasOnly(['credits', 'entries']) &&
        request.resource.data.credits is int &&
        request.resource.data.credits >= 0 && request.resource.data.credits <= 1 &&
        request.resource.data.credits <= assistantLimit() &&
        request.resource.data.entries is list && request.resource.data.entries.size() <= 1;
      allow update: if isSignedIn() && request.auth.token.userId == userId &&
        date == istDate() &&
        request.resource.data.keys().hasOnly(['credits', 'entries']) &&
        request.resource.data.credits >= resource.data.credits &&
        request.resource.data.credits <= resource.data.credits + 1 &&
        request.resource.data.credits <= assistantLimit() &&
        request.resource.data.entries.size() >= resource.data.entries.size() &&
        request.resource.data.entries.size() <= resource.data.entries.size() + 1 &&
        request.resource.data.entries.size() <= 200;
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    match /Users/{userId} {
      // Create: custom claim not set yet at first creation — verify via auth.uid
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Read / update / delete: self or any manager in the chain
      allow read, update, delete: if isSignedIn() && (
        request.auth.token.userId == userId ||
        request.auth.token.userId in resource.data.get('managers', [])
      );

      match /Tracking/{trackingId} {
        allow read, delete: if canAccessUser(userId);

        // Starting a session (punch-in) needs a current app build. The app
        // writes its build to the user's document; Config/app (server-only)
        // holds the minimum per platform. Builds before 17 never report a build,
        // so they count as 0 and are refused once minBuild is above 0.
        allow create: if canAccessUser(userId) && appIsCurrent(userId);

        // Reopening a closed session ("Resume Session") is a punch-in too; every
        // other update (heartbeat, locations, punch-out) is unchanged.
        allow update: if canAccessUser(userId) && (
          !(resource.data.get('isPunchedIn', false) == false &&
            request.resource.data.get('isPunchedIn', false) == true) ||
          appIsCurrent(userId)
        );
      }

      match /Visits/{visitId} {
        allow read, write: if canAccessUser(userId);

        match /Comments/{commentId} {
          allow read: if canAccessUser(userId);
          allow create: if canAccessUser(userId) &&
            request.resource.data.userId == request.auth.token.userId &&
            request.resource.data.text is string &&
            request.resource.data.timestamp is timestamp;
        }
      }

      match /Monthly/{yearMonth} {
        allow read, write: if canAccessUser(userId);
      }
    }
  }
}