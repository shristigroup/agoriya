rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the requester is the user themselves or one of their managers.
    // managers[] is a CF-maintained array of User doc IDs up the chain.
    function canAccessUser(userId) {
      let user = get(/databases/$(database)/documents/Users/$(userId));
      return isSignedIn() && (
        request.auth.token.userId == userId ||
        request.auth.token.userId in user.data.get('managers', [])
      );
    }

    // Whether this user's app is new enough to start a session. A missing
    // Config/app, or no minBuild for the user's platform, means no enforcement.
    function appIsCurrent(userId) {
      let user = get(/databases/$(database)/documents/Users/$(userId)).data;
      let cfg = get(/databases/$(database)/documents/Config/app).data;
      return !exists(/databases/$(database)/documents/Config/app) ||
        user.get('appBuild', 0) >=
          cfg.get(user.get('platform', 'android'), {}).get('minBuild', 0);
    }

    // ─── Codes — public read; all writes via CF only (createOrgCode) ─────────
    match /Codes/{code} {
      allow read: if true;
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    match /Users/{userId} {
      // Create: custom claim not set yet at first creation — verify via auth.uid
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Read / update / delete: self or any manager in the chain
      allow read, update, delete: if isSignedIn() && (
        request.auth.token.userId == userId ||
        request.auth.token.userId in resource.data.get('managers', [])
      );

      match /Tracking/{trackingId} {
        allow read, delete: if canAccessUser(userId);

        // Starting a session (punch-in) needs a current app build. The app
        // writes its build to the user's document; Config/app (server-only)
        // holds the minimum per platform. Builds before 17 never report a build,
        // so they count as 0 and are refused once minBuild is above 0.
        allow create: if canAccessUser(userId) && appIsCurrent(userId);

        // Reopening a closed session ("Resume Session") is a punch-in too; every
        // other update (heartbeat, locations, punch-out) is unchanged.
        allow update: if canAccessUser(userId) && (
          !(resource.data.get('isPunchedIn', false) == false &&
            request.resource.data.get('isPunchedIn', false) == true) ||
          appIsCurrent(userId)
        );
      }

      match /Visits/{visitId} {
        allow read, write: if canAccessUser(userId);

        match /Comments/{commentId} {
          allow read: if canAccessUser(userId);
          allow create: if canAccessUser(userId) &&
            request.resource.data.userId == request.auth.token.userId &&
            request.resource.data.text is string &&
            request.resource.data.timestamp is timestamp;
        }
      }

      match /Monthly/{yearMonth} {
        allow read, write: if canAccessUser(userId);
      }
    }
  }
}