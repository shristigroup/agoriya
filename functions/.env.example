# Location tracking tuning — shared between the Flutter app and Cloud Functions.
#
# Copy this file to `.env` (gitignored) in this same directory and edit that
# copy — `.env` is what both sides actually read:
#   - Cloud Functions load it automatically on deploy/emulate (functions v2).
#   - The Flutter app reads it via `--dart-define-from-file=functions/.env`,
#     passed to `flutter run` / `flutter build` (already wired into deploy.sh).
#
# To test faster sync/watchdog behavior, drop these to e.g. 2/1/1, redeploy
# functions and rerun the app, verify, then revert to the defaults below
# before deploying for real.

# Minutes between GPS samples. Read by both the app
# (AppConstants.locationSamplingSeconds) and the watchdog's staleness gate
# (functions/index.js, HEARTBEAT_STALE_THRESHOLD_MS = 2x this) — the app
# writes locationHeartbeatTimestamp to the Tracking doc on every sample, and
# the watchdog treats it stale once more than two sample intervals have
# passed without a fresh one.
LOCATION_SAMPLE_INTERVAL_MINUTE=1

# Minutes of GPS samples collected before a batch auto-syncs to Firestore.
# Read by the app (AppConstants.locationBatchSize) and by the watchdog's
# FCM handler client-side (LocationSyncService.isFinalLocationsStale) as the
# "has it been long enough since the last real sync to force one" margin.
LOCATION_BATCH_MINUTES=15

# How often (in minutes) the watchdog scheduled function runs. Functions-only.
WATCHDOG_SCHEDULE_MINUTES=5

# Consecutive missed pings (each WATCHDOG_SCHEDULE_MINUTES apart) before the
# watchdog gives up on a session and auto punches the user out. Functions-only.
WATCHDOG_PING_COUNT_THRESHOLD=2
